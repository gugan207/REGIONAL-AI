# ==============================================================================
# REGIONAL - AI — Environment Variable Contract
# ==============================================================================
# WARNING:
# 1. Do NOT put real credentials or secrets in this file.
# 2. Do NOT commit .env or secret credentials to version control.
# 3. This file serves as the configuration template for the backend API.
# 4. Copy this file to .env on your private backend server when configuring live APIs.
# 5. FRONTEND SECURITY: Never expose these keys to the frontend React bundle.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Backend Only — Sole LLM Provider)
# ------------------------------------------------------------------------------
# API Key obtained from Google AI Studio
GEMINI_API_KEY=

# Foundation model identifier for roadmap, resume, and skill gap reasoning
# Options: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.8-flash

# HTTP client timeout in milliseconds (fallback triggers upon timeout)
GEMINI_REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# YouTube Data API v3 Configuration (Backend Only)
# ------------------------------------------------------------------------------
# Google Cloud Platform API Key with YouTube Data API v3 enabled
YOUTUBE_API_KEY=

# Base URL for YouTube Data API v3
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# Cache time-to-live in seconds (prevents quota exhaustion: 86400s = 24 hours)
YOUTUBE_CACHE_TTL_SECONDS=86400

# Max search results fetched before internal scoring and deduplication
YOUTUBE_MAX_RESULTS_PER_QUERY=10

# ------------------------------------------------------------------------------
# Backend Server Runtime Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Force deterministic demo data mode regardless of API key presence (true/false)
FORCE_DEMO_FALLBACK=false

# ------------------------------------------------------------------------------
# Supabase Frontend Configuration (VITE_ prefixed — safe for browser exposure)
# ------------------------------------------------------------------------------
# Supabase project URL: https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_URL=
# Supabase public (anon) key: obtained from Supabase Project > Settings > API
VITE_SUPABASE_PUBLISHABLE_KEY=
